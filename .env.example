# =====================================================================
# Pépite — variables d'environnement
# Copie ce fichier en .env.local et remplis ce que tu as.
# Sans aucune clé, l'appli démarre en « mode local » : base dans .data/,
# lien magique affiché à l'écran, données fictives, scripts simulés,
# paiement simulé. Rien ne plante si une clé manque.
# =====================================================================

# --- Supabase (base de données + connexion) ---------------------------
# Les trois sont nécessaires. Vides = mode local (fichier .data/local-db.json).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (écriture des scripts) ------------------------------------
# Vide = générateur de scripts simulé (gratuit, déterministe).
ANTHROPIC_API_KEY=
# Modèle utilisé pour les scripts.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Stripe (abonnements) ---------------------------------------------
# Vide = paiement désactivé avec un message clair (et simulé en mode local).
STRIPE_SECRET_KEY=
# Secret du point de terminaison webhook (/api/stripe/webhook), commence par whsec_.
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix (price_…) créés dans Stripe. Voir README, section Stripe.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PROPLUS_MONTHLY=
STRIPE_PRICE_PROPLUS_YEARLY=

# --- E-mails (Resend) -------------------------------------------------
# Vide = e-mails affichés dans la console et la boîte locale (/admin).
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, ex. « Pépite <bonjour@ton-domaine.fr> ».
EMAIL_FROM=
# Adresse qui reçoit les demandes de partenariat des formateurs.
FOUNDER_EMAIL=

# --- Discord (bot du récap du matin) -----------------------------------
# Utilisées par le bot (dossier bot/). L'appli n'en a pas besoin pour démarrer.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Secret partagé entre le bot et l'appli (routes /api/bot/*). Mets une longue chaîne aléatoire.
BOT_API_SECRET=
# Lien d'invitation vers ton serveur Discord, affiché dans l'appli.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# --- Données produits ---------------------------------------------------
# mock = données fictives réalistes (par défaut) | tiktok = API affiliés officielle | nexscope = fournisseur tiers
DATA_PROVIDER=mock
# API TikTok Shop (programme affiliés / partenaires).
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Jeton d'accès obtenu via l'autorisation du compte créateur/partenaire (voir lib/data/tiktok.ts).
TIKTOK_ACCESS_TOKEN=
# Fournisseur de données tiers.
NEXSCOPE_API_KEY=

# --- Tâches planifiées ----------------------------------------------------
# Protège /api/cron/*. Vercel l'envoie automatiquement si la variable existe.
CRON_SECRET=

# --- Site -------------------------------------------------------------------
# URL publique du site (liens des e-mails, redirections de connexion).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# E-mails administrateurs, séparés par des virgules. En mode local, vide = admin@pepite.local.
ADMIN_EMAILS=

# --- Mode local uniquement ---------------------------------------------------
# Secret de signature du cookie de session locale (facultatif en local).
LOCAL_AUTH_SECRET=
# Emplacement de la base locale.
LOCAL_DB_PATH=.data/local-db.json
