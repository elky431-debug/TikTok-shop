# =====================================================================
# Tracktout — variables d'environnement
# Copie ce fichier en .env.local et remplis ce que tu as.
# Sans aucune clé, l'appli démarre en « mode local » : base dans .data/,
# lien magique affiché à l'écran, données fictives, scripts simulés,
# paiement simulé. Rien ne plante si une clé manque.
# =====================================================================

# --- Supabase (base de données + connexion) ---------------------------
# Les trois sont nécessaires. Vides = mode local (fichier .data/local-db.json).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# Pour « npm run db:setup » uniquement (jamais lus par l'appli, jamais sur Vercel). L'un ou l'autre :
# - jeton personnel (supabase.com → Account → Access Tokens) : migrations et types par l'API de gestion, en HTTPS
#   (conseillé, marche même quand le port 5432 de Postgres est fermé) ;
SUPABASE_ACCESS_TOKEN=
# - chaîne de connexion Postgres (Connect → Session pooler), avec le mot de passe de la base.
SUPABASE_DB_URL=

# --- IA (écriture des scripts) ------------------------------------------
# openai | anthropic. Sans valeur : Claude si sa clé est là, sinon OpenAI.
# Clé du fournisseur choisi absente = générateur de scripts simulé (gratuit, déterministe).
AI_PROVIDER=
# OpenAI (https://platform.openai.com/api-keys). Modèle par défaut : gpt-6-luna, le moins cher qui gère
# les sorties JSON structurées. gpt-5.5 écrit avec plus de punch mais coûte environ 55 fois plus (DECISIONS.md, 115).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Claude (https://console.anthropic.com).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Stripe (abonnements) ---------------------------------------------
# Vide = paiement désactivé avec un message clair (et simulé en mode local).
STRIPE_SECRET_KEY=
# Secret du point de terminaison webhook (/api/stripe/webhook), commence par whsec_.
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix (price_…) créés dans Stripe. Voir README, section Stripe.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PROPLUS_MONTHLY=
STRIPE_PRICE_PROPLUS_YEARLY=
# Portail client créé par « npm run stripe:setup » (changement de plan, résiliation) ; facultatif
STRIPE_PORTAL_CONFIGURATION=

# --- E-mails (Resend) -------------------------------------------------
# Vide = e-mails affichés dans la console et la boîte locale (/admin).
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, ex. « Tracktout <bonjour@ton-domaine.fr> ».
EMAIL_FROM=
# Adresse qui reçoit les demandes de partenariat des formateurs.
FOUNDER_EMAIL=

# --- Connexion Google (lus par « npm run auth:setup » seulement, pas par le site) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Discord (récap du matin, sans serveur à héberger) ------------------
# Developer Portal → General Information (Application ID, Public Key) et onglet Bot (jeton). Voir README, section 4.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Serveur, rôle Pro et salons (mode développeur de Discord → clic droit → Copier l'identifiant).
DISCORD_GUILD_ID=
DISCORD_PRO_ROLE_ID=
DISCORD_PUBLIC_CHANNEL_ID=
DISCORD_PRO_CHANNEL_ID=
# Heure de Paris de la publication dans les salons (8 par défaut).
DISCORD_PUBLIC_POST_HOUR=
# Lien d'invitation vers ton serveur Discord, affiché dans l'appli.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# --- Données produits ---------------------------------------------------
# auto (par défaut) : TikTok si ses clés sont là, sinon Nexscope, sinon données fictives.
# Ou forcer : tiktok | nexscope | mock. Si la source réelle échoue la nuit, repli automatique
# (Nexscope si sa clé est là, puis données fictives, jamais présentées comme réelles).
DATA_PROVIDER=auto
# API officielle TikTok Shop (Partner Center, API « Affiliate Creator »).
# Attention : la doc indique que ces API ne sont pas encore ouvertes dans l'UE (voir DECISIONS.md).
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Jeton d'un compte créateur (user_type 1) qui a autorisé l'appli (voir lib/data/tiktok-creator.ts).
TIKTOK_ACCESS_TOKEN=
# Facultatif : niche → catégorie de 1er niveau TikTok Shop, ex. beaute:601450,maison:600001
TIKTOK_CATEGORY_MAP=
# Fournisseur de données sous contrat (https://www.nexscope.ai/seller/api-access).
NEXSCOPE_API_KEY=
# Limites des appels à la source réelle (la nuit) : quota, débit, cache, pages par niche, vidéos.
DATA_MAX_CALLS_PER_NIGHT=60
DATA_RATE_PER_SECOND=1
DATA_CACHE_HOURS=20
DATA_PAGES_PER_NICHE=3
# Vidéos chargées chez Nexscope chaque nuit (les N meilleurs produits ; cache de 3 jours). 10 par défaut.
NEXSCOPE_MAX_VIDEO_CALLS_PER_NIGHT=10
# Produits dont on lit les ventes par période chaque nuit (lots de 20), parmi ceux qui ont moins de 7 jours de relevés.
NEXSCOPE_MAX_DETAIL_PRODUCTS_PER_NIGHT=40
# Domaines d'images produits en plus de ceux de config/image-hosts.mjs (séparés par des virgules,
# « *. » accepté en tête). L'écran admin liste les domaines refusés après chaque nuit. Redéployer après changement.
IMAGE_HOSTS=

# --- Tâches planifiées ----------------------------------------------------
# Protège /api/cron/*. Vercel l'envoie automatiquement si la variable existe.
CRON_SECRET=

# --- Site -------------------------------------------------------------------
# URL publique du site (liens des e-mails, redirections de connexion).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# E-mails administrateurs, séparés par des virgules. En mode local, vide = admin@tracktout.local.
ADMIN_EMAILS=

# --- Mode local uniquement ---------------------------------------------------
# Secret de signature du cookie de session locale (facultatif en local).
LOCAL_AUTH_SECRET=
# Emplacement de la base locale.
LOCAL_DB_PATH=.data/local-db.json
