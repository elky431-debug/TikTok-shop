# Bot Discord : copie en .env et remplis.
# Jeton du bot (Discord Developer Portal > Bot > Reset Token).
DISCORD_BOT_TOKEN=
# Identifiant de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant).
DISCORD_GUILD_ID=
# Identifiant de l'application (Developer Portal > General Information > Application ID).
DISCORD_CLIENT_ID=
# Salon public « produits-du-jour » (3 produits masqués pour tout le monde).
DISCORD_PUBLIC_CHANNEL_ID=
# Salon réservé au rôle Pro (liste complète).
DISCORD_PRO_CHANNEL_ID=
# Rôle donné aux abonnés Pro et Pro+ (synchronisé avec le plan).
DISCORD_PRO_ROLE_ID=
# URL de l'appli et secret partagé (même valeur que BOT_API_SECRET côté appli).
APP_URL=http://localhost:3000
BOT_API_SECRET=
# Heure de publication dans le salon public (heure de Paris).
PUBLIC_POST_HOUR=8
